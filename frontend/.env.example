# Next Server Components and local rewrites use this internal Go API origin.
# Browser requests always remain relative to /api.
BACKEND_INTERNAL_URL=http://localhost:5000

# Shared only by the backend worker and the Docker-internal Next route.
REVALIDATION_TOKEN=

# Used by post-deploy sitemap prewarming; never contacted during image builds.
PUBLIC_SITE_URL=http://localhost:3000
