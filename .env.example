# ============================================
# MyWebsite production deployment env template
# Copy this file to .env and fill real values:
#   cp .env.example .env
# Docker Compose automatically reads .env in this directory.
# ============================================

# ============================
# Backend service
# ============================

PORT=5000

# Database
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-this-password
DB_NAME=mywebsite
DB_SCHEMA=public

# Security - production must override these values.
SECRET_KEY=change-this-in-production
JWT_SECRET_KEY=change-this-in-production

# Initial admin account - production must override these values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Upload and media limits
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=52428800
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp

# Media storage: local or s3
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# Reliable Next cache revalidation. Use the same token for backend and Next.
NEXT_REVALIDATION_URL=http://next-web:3000/internal/revalidate
REVALIDATION_TOKEN=change-this-revalidation-token

# Edge origin served to browsers.
CORS_ALLOWED_ORIGINS=http://localhost:4419

# OpenAI configuration - leave empty to disable AI features.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_API_URL=https://api.openai.com/v1

# JWT expiration in seconds
JWT_ACCESS_TOKEN_EXPIRES=86400
JWT_REMEMBER_TOKEN_EXPIRES=604800

# Comment limits
COMMENT_LIMIT_ENABLED=true
COMMENT_LIMIT_TIME_WINDOW=24
COMMENT_LIMIT_MAX_COUNT=1
COMMENT_LIMIT_EXEMPT_ADMIN=true

# ============================
# Next / edge service
# ============================

# Docker-internal origin used by Next Server Components and rewrites.
BACKEND_INTERNAL_URL=http://backend:5000

# Public canonical origin used by metadata, robots, sitemap and prewarm.
PUBLIC_SITE_URL=http://localhost:4419

# ============================
# Docker / shared config
# ============================

TZ=Asia/Shanghai
