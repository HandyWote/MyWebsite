# ============================================
# 后端开发环境变量模板
# 复制此文件为 .env 并根据本地环境修改
# cp .env.example .env
# ============================================

# 服务端口
PORT=5000

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=mywebsite
DB_SCHEMA=public

# 安全配置（生产环境务必修改）
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=dev-jwt-secret-change-in-production

# 管理员账号（生产环境务必修改）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 文件上传与对象存储配置
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=52428800
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# Next cache revalidation（生产必须同时配置 URL 与非空 token）
NEXT_REVALIDATION_URL=
REVALIDATION_TOKEN=

# 浏览器跨域白名单；生产同域部署可留空
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4419

# OpenAI 配置（可选，留空则禁用 AI 功能）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_API_URL=https://api.openai.com/v1

# JWT 有效期（秒）
JWT_ACCESS_TOKEN_EXPIRES=86400
JWT_REMEMBER_TOKEN_EXPIRES=604800

# 评论限制配置
COMMENT_LIMIT_ENABLED=true
COMMENT_LIMIT_TIME_WINDOW=24
COMMENT_LIMIT_MAX_COUNT=1
COMMENT_LIMIT_EXEMPT_ADMIN=true

# GitHub OAuth 登录配置（可选，留空则禁用 GitHub 登录）
# 回调地址必须与 GitHub OAuth App 中配置的 Callback URL 完全一致
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://<域名>/api/auth/github/callback

# 登录接口限流（按 IP 计数，窗口单位为分钟）
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
